FLASK_DEBUG=false
FRONTEND_ORIGIN=http://localhost:5173

# Copy this file to .env and set the password for your MySQL account.
# Never commit real credentials.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nutriscan
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
JWT_SECRET_KEY=generate_a_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=60
